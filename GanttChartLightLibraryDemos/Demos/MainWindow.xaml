<Window x:Class="Demos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demos"
        mc:Ignorable="d"
        Title="Demos - Gantt Chart Library - DlhSoft"
        Width="1200" Height="800"
        WindowState="Maximized"
        Closing="Window_Closing">
    <Window.Resources>
        <local:UppercaseConverter x:Key="UppercaseConverter"/>
        <local:FileNameConverter x:Key="FileNameConverter"/>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="16,0"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TextBlock}}"/>
            <Setter Property="TextDecorations" Value="None"/>
            <EventSetter Event="RequestNavigate" Handler="Hyperlink_RequestNavigate"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#7BA6EC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding Converter={StaticResource UppercaseConverter}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RunListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem.Opacity, ElementName=TreeView}" Value="0.65">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThemeListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource RunListBoxItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=ThemeComboBox}" Value="Default">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="16,8"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="10,11"/>
            <Setter Property="MaxDropDownHeight" Value="Infinity"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Panel}}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding Converter={StaticResource UppercaseConverter}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Margin" Value="-1,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#fff"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#4c4c4c"/>
            <Setter Property="Background" Value="#F2F6FC"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" BorderThickness="1" BorderBrush="#D3DFF1" Background="{TemplateBinding Background}" CornerRadius="7" Padding="3" Margin="4,4,2,2">
                            <Grid>
                                <TextBlock Name="Text" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" 
                                    Margin="3,1" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    TextWrapping="Wrap" TextTrimming="WordEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5D8DE0"/>
                                <Setter TargetName="Border" Property="Background" Value="#5E8CDE"/>
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#F0F5FD"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#D5E0F1"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#1F2B35" TextElement.Foreground="#E8F0F6" Height="55">
            <TextBlock DockPanel.Dock="Left" Margin="32,0" VerticalAlignment="Center">
                <Hyperlink NavigateUri="http://DlhSoft.com">
                    <Image Source="http://DlhSoft.com/Images/Logo-light.png" Height="33"/>
                </Hyperlink>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0">
                <TextBlock>
                    <Span>DEMOS</Span>
                    <Span> – </Span>
                    <Hyperlink NavigateUri="http://DlhSoft.com/GanttChartLibrary.wpf">
                        GANTT CHART LIBRARY
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink NavigateUri="http://DlhSoft.com/Goto.aspx?Url=GanttChartLibrary.wpf/Documentation/index.html">
                        DOCUMENTATION
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink NavigateUri="http://DlhSoft.com/GanttChartLibrary.wpf/Download.aspx">
                        DOWNLOADS
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink NavigateUri="http://DlhSoft.com/GanttChartLibrary.wpf/Purchase.aspx">
                        ORDER LICENSES
                    </Hyperlink>
                </TextBlock>
                <TextBlock>
                    <Hyperlink NavigateUri="http://DlhSoft.com/GanttChartLibrary.wpf/Support.aspx">
                        SUPPORT
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Background="#F7FAFD" BorderBrush="#D7E2EC" BorderThickness="0,0,0,1">
        <Viewbox HorizontalAlignment="Right" Margin="16,0" Height="55">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="55">
                <ListBox Name="FilesListBox" SelectionMode="Single" SelectionChanged="FilesListBox_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="Run" Foreground="#5D8DE0" Margin="20,0" Style="{StaticResource RunListBoxItemStyle}"/>
                    <ListBoxItem Content="Common.xaml" Tag="Themes/Common.xaml" Style="{StaticResource ThemeListBoxItemStyle}"/>
                    <ListBoxItem Content="{Binding SelectedItem.Tag, ElementName=ThemeComboBox, Converter={StaticResource FileNameConverter}, ConverterParameter=.xaml}" Tag="{Binding SelectedItem.Tag, ElementName=ThemeComboBox, Converter={StaticResource FileNameConverter}, ConverterParameter=Themes/*.xaml}" Style="{StaticResource ThemeListBoxItemStyle}"/>
                </ListBox>
                <Button Name="GetZipButton" Content=".ZIP" Click="GetZipButton_Click"/>
        <ComboBox Name="ThemeComboBox" Foreground="#5D8DE0" SelectionChanged="ThemeComboBox_SelectionChanged">
            <ComboBox.Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem.Opacity, ElementName=TreeView}" Value="0.65">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                    </ComboBox.Style>
                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding Converter={StaticResource UppercaseConverter}}"/>
                                            <ContentPresenter Content=" THEME"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                </ComboBox.Resources>
                    <ComboBoxItem Content="Default" Tag="Default"/>
                    <ComboBoxItem Content="Coastal Blue" Tag="Coastal-blue" IsSelected="True"/>
                    <ComboBoxItem Content="Generic-bright" Tag="Generic-bright"/>
                    <ComboBoxItem Content="Generic-blue" Tag="Generic-blue"/>
                    <ComboBoxItem Content="DlhSoft" Tag="DlhSoft"/>
                    <ComboBoxItem Content="Purple-green" Tag="Purple-green"/>
                    <ComboBoxItem Content="Steel-blue" Tag="Steel-blue"/>
                    <ComboBoxItem Content="Dark-black" Tag="Dark-black"/>
                    <ComboBoxItem Content="Cyan-green" Tag="Cyan-green"/>
                    <ComboBoxItem Content="Blue-navy" Tag="Blue-navy"/>
                    <ComboBoxItem Content="Orange-brown" Tag="Orange-brown"/>
                    <ComboBoxItem Content="Teal-green" Tag="Teal-green"/>
                    <ComboBoxItem Content="Purple-beige" Tag="Purple-beige"/>
                    <ComboBoxItem Content="Gray-blue" Tag="Gray-blue"/>
                    <ComboBoxItem Content="Light-blue" Tag="Light-blue"/>
                    <ComboBoxItem Content="Yellow-green" Tag="Yellow-green"/>
                    <ComboBoxItem Content="Green-blue" Tag="Green-blue"/>
</ComboBox>
                <ComboBox Name="TechnologyComboBox" HorizontalContentAlignment="Right" SelectionChanged="TechnologyComboBox_SelectionChanged">
                <ComboBoxItem Content="WPF – C#" Tag="WPF-CSharp" IsSelected="True"/>
                <ComboBoxItem Content="WPF – VB.NET" Tag="WPF-VisualBasic"/>
            </ComboBox>
        </StackPanel>
        </Viewbox>
        </Border>
        <Border BorderBrush="#E4EBF2" BorderThickness="0,1,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <Border DockPanel.Dock="Top" Margin="4,8,0,6" Background="#FAFCFE" BorderBrush="#D7E1EA" BorderThickness="1" CornerRadius="4">
                        <TextBox Name="TreeViewSearchTextBox" Text="Search..." Padding="10,8" Margin="0" Background="Transparent" Foreground="Gray" BorderThickness="0"
                                 GotKeyboardFocus="TreeViewSearchTextBox_GotKeyboardFocus" LostKeyboardFocus="TreeViewSearchTextBox_LostKeyboardFocus"
                                 TextChanged="TreeViewSearchTextBox_TextChanged"/>
                        </Border>
                <TabControl x:Name="TabControl" TabStripPlacement="Bottom" Margin="0,0,0,0" SelectionChanged="TabControl_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="ListBox">
                            <Setter Property="Margin" Value="0,0,0,-1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Padding" Value="8,8"/>
                            <Setter Property="Foreground" Value="#243444"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF4FC"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#CFDAEA"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F7FAFD"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E2EAF5"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="MinWidth" Value="96"/>
                            <Setter Property="Height" Value="52"/>
                            <Setter Property="Padding" Value="5,3"/>
                        </Style>
                    </TabControl.Resources>
                </TabControl>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="Transparent"/>
                    <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="#E4EBF2">
                        <Grid>
                            <ContentPresenter Name="ContentPresenter"/>
                            <TextBox Name="ContentTextBox" IsReadOnly="True" FontFamily="Courier New" 
                                     BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     Visibility="Hidden"/>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>











