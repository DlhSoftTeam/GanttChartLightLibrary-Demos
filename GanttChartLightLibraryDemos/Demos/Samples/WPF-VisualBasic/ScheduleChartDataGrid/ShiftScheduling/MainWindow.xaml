<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pdgcc="clr-namespace:DlhSoft.Windows.Controls;assembly=DlhSoft.ProjectData.GanttChart.LightWPF.Controls"
        Title="ScheduleChartDataGrid Shift Scheduling Sample" Width="800" Height="600">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="CustomScaleHeaderContentTemplate">
                <Border Background="Transparent" MinWidth="48">
                    <TextBlock Text="{Binding}"
                               Margin="6,0"
                               VerticalAlignment="Center"
                               TextAlignment="Left"
                               FontWeight="SemiBold"/>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <pdgcc:ScheduleChartDataGrid x:Name="ScheduleChartDataGrid" DataGridWidth="0.1*" ChartWidth="0.9*" HourWidth="10"
                                     IsTaskStartReadOnly="True" IsTaskFinishReadOnly="True" IsTaskCompletedEffortVisible="False"
                                     WorkingWeekStart="Sunday" WorkingWeekFinish="Saturday" 
                                     WorkingDayStart="00:00:00" WorkingDayFinish="24:00:00" VisibleDayStart="00:00:00" VisibleDayFinish="24:00:00"
                                     AreUpdateTimelinePageButtonsVisible="False">
            <pdgcc:GanttChartDataGrid.Scales>
                <pdgcc:ScaleCollection>
                    <pdgcc:Scale ScaleType="Days" HeaderContentFormat="ShortDate" HeaderBorderBrush="#E4EBF2" HeaderBorderThickness="0,0,1,1" HeaderContentTemplate="{StaticResource CustomScaleHeaderContentTemplate}" BorderBrush="#E4EBF2"/>
                    <pdgcc:Scale ScaleType="Days" HeaderContentFormat="DayOfWeek" HeaderBorderBrush="#E4EBF2" HeaderBorderThickness="0,0,1,1" HeaderContentTemplate="{StaticResource CustomScaleHeaderContentTemplate}"/>
                    <pdgcc:Scale ScaleType="Custom" HeaderContentFormat="Custom" HeaderBorderBrush="#E4EBF2" HeaderBorderThickness="0,0,1,1" HeaderContentTemplate="{StaticResource CustomScaleHeaderContentTemplate}" BorderBrush="#E4EBF2" BorderThickness="0,0,1,1" />
                </pdgcc:ScaleCollection>
            </pdgcc:GanttChartDataGrid.Scales>
        </pdgcc:ScheduleChartDataGrid>
    </DockPanel>
</Window>









